{
    "compilerOptions": {
        "baseUrl": "./src",
        "paths": {
            "@assets/*": ["assets/*"],
            "@theme": ["theme/index"],
            "@services": ["services/index"],
            "@services/*": ["services/*"],
            "@store": ["store/index"],
            "@pages": ["pages/index"],
            "@hooks": ["hooks/index"],
            "@layouts": ["layouts/index"],
            "@routes": ["routes/index"],
